<div class="detail_banner" style="margin:0 auto;max-width:1200px">
	<img style="width:100%;" src="/images/banner-2.png" alt=""></div>

	<script>
		var alias = "";
  alias = "index";
$(function(){
  displayNotice(function(data){
    //獲取告示數據
    bulidHTML(data);
    if ($('.swiperNotice').children('div').length > 0) {
      $('.detail_banner').empty();
      $('#swiperBanner').empty();
      $('#swiperNotice').show();
      var  play = $('.swiperNotice').children('div').length > 1 ? true : false;
      var swiperNotice = new Swiper('#swiperNotice', {
          autoHeight: true,
          observer:true,
          observeParents:true,
          autoplay: {
                  disableOnInteraction: false,
                  delay: 10000,
          },
          loop: true, 
          effect : 'fade',
          fadeEffect: {
          crossFade: true
          },
          navigation: {
            nextEl: '.swiper-button-next',
            prevEl: '.swiper-button-prev',
            hideOnClick: play
          }
          });
          swiperNotice.allowTouchMove= play;
          if (play) {
            $('.noticeBtn_show').show();
          } else {
              $('.notice_date').removeClass('notice_width');
              swiperNotice.autoplay.stop();
          }
      } else if ($('.swiperNotice').children('div').length == 0 && alias == 'index'){
      //用戶環境alias為index
          $('.detail_banner').empty();
          $('#swiperNotice').empty();
          $('#swiperBanner').show();
          var swiperBanner = new Swiper('#swiperBanner', {
              autoplay: {
                  disableOnInteraction: false,
                  delay: 5000,
              },
              loop: true
          }); 
      } else {
            $('#swiperNotice').empty();
            $('#swiperBanner').empty();
            $('.detail_banner').show();
      }
  });
});

function num(s) {
	return s < 10 ? '0' + s: s;
}
function FormatDate (strTime) {
  //strTime = strTime.substring(0, 25).replace(',', '');
  var pubDate = new Date(strTime);
  if(strTime.indexOf("CST")) {
  pubDate.setHours(pubDate.getHours()-14);
  }
  return pubDate;
}

function displayNotice(callback) {
	$.ajax({
    url: "/rss/tc/notice.rss",
		type: 'GET',
		dataType: 'xml',
		timeout: 20000,
    async: false,
		cache: false,
    global: false,
		success: function(res) {
      var data = $(res).find("channel");
      callback(data);
		},
		error: function(err) {
      // callback(null);
		}
	})
}


function bulidHTML(data) {
      var html = "";
      if (!data) return
      $(data).find("item").each(function() {
        var show = $(this).find("show").text();
        var repalceBody = "";
				if (window.navigator && window.navigator.msSaveOrOpenBlob) {
					replaceBody = $(this).context.lastChild.textContent;
				} else {
					replaceBody = $(this).context.lastChild.innerHTML.replace("<![CDATA[", "").replace("]]>", "");
				}
        if (show === "true" && $(this).context.lastChild.textContent) {
          var time = $(this).find("pubDate").text();
          time = time.replace(/ GMT.+$/, '');
          time = FormatDate(time);
				  var date = new Date(time);
				  dateStr = num(date.getDate()) + '/' + num((date.getMonth() + 1)) + '/' + num(date.getFullYear()) + ' ' + num(date.getHours())+ ':' + num(date.getMinutes());
          html += "<div class='swiper-slide'>";
          html += "<div class='swiper-slideDiv'>";
          html += "<div class='notice_content'>";
          html += "<div>" + replaceBody + "</div><br />";
          html += "<div class='notice_date'><span>發佈日期：</span><span>" + dateStr + "</span></div>";
          html += "</div></div></div>";
        }
      })
      $(".swiperNotice").append(html);
}


	</script></div></div></div></div><div class="cms-layout-row" style=""><div key="r1c0" body="true" class="cms-layout-column" style=""><div class="cms-layout" style=""><div class="cms-layout-row" style="min-height:200px;"><div key="r0c0" class="cms-layout-column appContainer" style=""><div section-id="2336" class="cms-section" style="padding: 0px; "><div style="margin: 0 auto; padding: 0;"><div style="margin: 0 auto; max-width: 1200px; position: relative">
    <div class="waystitle_app">
        <span>路線查詢</span>
    </div>
    <div class="way_search" style="position: relative">
        <div class="waytitle_div">
            <!---<div><img style="width: 70%;"  src="/images/shape_ways.png" alt=""></div>-->
            <div class="ways_title">
                路線查詢
            </div>
        </div>

        <div class="search_waysDiv">
            <div class="ways_flexDiv">
                <div class="startEnd_Div">
                    <img
                        src="/images/start.png"
                        alt=""
                    />起點
                </div>
                <div class="select-box">
                    <span
                        style="background-color: #ffa90b"
                        class="span_point"
                    ></span>
                    <select class="form-line">
                        <option value="1">
                            氹仔線
                        </option>
                        <option value="2">
                            石排灣線
                        </option>
                        <option value="3">橫琴線</option>
                    </select>
                    <select class="form"></select>
                </div>
            </div>
            <div class="ways_flexDiv">
                <div class="startEnd_Div">
                    <img
                        src="/images/end.png"
                        alt=""
                    />終點
                </div>
                <div class="select-box">
                    <span
                        style="background-color: #039bda"
                        class="span_point"
                    ></span>
                    <select class="to-line">
                        <option value="1">
                            氹仔線
                        </option>
                        <option value="2">
                            石排灣線
                        </option>
                        <option value="3">橫琴線</option>
                    </select>
                    <select class="to"></select>
                </div>
            </div>
            <div class="ways_searchBtn" id="to_link" style="width: 10%">
                搜索
            </div>
        </div>
    </div>
</div>

<script>
    var taipa_line = [
        { text: "媽閣站", value: "1" },
        { text: "海洋站", value: "2" },
        { text: "馬會站", value: "3" },
        { text: "運動場站", value: "4" },
        { text: "排角站", value: "5" },
        { text: "路氹西站", value: "6" },
        {
            text: "蓮花站（轉乘橫琴線）",
            value: "7.1",
        },
        {
                text: "協和醫院站（轉乘石排灣線）",
                value: "8.1",
            },
        {
            text: "東亞運站",
            value: "9",
        },
        { text: "路氹東站", value: "10" },
        { text: "科大站", value: "11" },
        { text: "機場站", value: "12" },
        {
            text: "氹仔碼頭站",
            value: "13",
        },
    ];
    var spv_line = [
        {
            text: "協和醫院站(轉乘氹仔線)",
            value: "8.1",
        },
        { text: "石排灣站", value: "8.2" },
    ];
    var Hengqin_line = [
        { text: "蓮花站(轉乘氹仔線)", value: "7.1" },
        { text: "橫琴站", value: "7.2" },
    ];
    populateOptions(taipa_line, "form");
    populateOptions(taipa_line, "to");
    function populateOptions(array, name) {
        // 遍歷數組，動態生成選項
        $.each(array, function (index, item) {
            $("." + name).append(
                '<option value="' + item.value + '">' + item.text + "</option>"
            );
        });
    }

    $(".form-line").on("change", function () {
        var value = $(this).val(); // 獲取選中的值
        // 清空第二個選擇框的選項
        $(".form").val("");
        $(".form").html("");
        // 根據選擇的值更新第二個選擇框
        if (value === "1") {
            populateOptions(taipa_line, "form");
        } else if (value === "2") {
            populateOptions(spv_line, "form");
        } else if (value === "3") {
            populateOptions(Hengqin_line, "form");
        }
    });
    $(".to-line").on("change", function () {
        var value = $(this).val(); // 獲取選中的值
        // 清空第二個選擇框的選項
        $(".to").val("");
        $(".to").html("");
        // 根據選擇的值更新第二個選擇框
        if (value === "1") {
            populateOptions(taipa_line, "to");
        } else if (value === "2") {
            populateOptions(spv_line, "to");
        } else if (value === "3") {
            populateOptions(Hengqin_line, "to");
        }
    });

    $("#to_link").click(function () {
        var index_form = $(".form option:selected").val();
        var index_to = $(".to option:selected").val();
        var index_form_line = $(".form-line option:selected").val();
        var index_to_line = $(".to-line option:selected").val();
        sessionStorage.setItem("form", index_form_line+'-'+index_form);
        sessionStorage.setItem("to", index_to_line+'-'+index_to);
        window.location.href = "/tc/route.html";
    });
</script></div></div><div section-id="2354" class="cms-section" style="padding: 0px; "><div style="margin: 0 auto; padding: 0;"><script type="text/javascript">//$(function() {
