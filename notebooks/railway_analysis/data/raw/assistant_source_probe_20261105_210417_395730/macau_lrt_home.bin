body {
font-family: "微軟正黑體", "Microsoft JhengHei", "新細明體", "PMingLiU", AppleGothic, Dotum, Lucida Grande, Verdana Sans-serif;
}

.select-box {
	position: relative;
	display: flex;
	gap: 5px;
}
.search_waysDiv {
	width: 80%;
	text-align: center;
	padding-left: 18%;
	align-items: flex-end;
	justify-content: space-around;
}
.ways_flexDiv {
	padding-right: 30px;
}
.ways_searchBtn {
	text-align: center;
	background-color: #FFA90B;
	border-radius: 5px;
	color: #ffffff;
	font-size: 20px;
	height: 50px;
	line-height: 50px;
	align-items: center;
	cursor: pointer;
	justify-content: center;
}
.search_waysDiv>div {
	display: inline-table;
	vertical-align: bottom;
	width: 35%;
}
