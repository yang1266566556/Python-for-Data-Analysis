<div class="detail_banner" style="margin:0 auto;max-width:1200px">
	<img style="width:100%;" src="/images/banner-2.png" alt=""></div>

	<script>
		var alias = "";
  alias = "route";
$(function(){
  displayNotice(function(data){
    //獲取告示數據
    bulidHTML(data);
    if ($('.swiperNotice').children('div').length > 0) {
      $('.detail_banner').empty();
      $('#swiperBanner').empty();
      $('#swiperNotice').show();
      var  play = $('.swiperNotice').children('div').length > 1 ? true : false;
      var swiperNotice = new Swiper('#swiperNotice', {
          autoHeight: true,
          observer:true,
          observeParents:true,
          autoplay: {
                  disableOnInteraction: false,
                  delay: 10000,
          },
          loop: true, 
          effect : 'fade',
          fadeEffect: {
          crossFade: true
          },
          navigation: {
            nextEl: '.swiper-button-next',
            prevEl: '.swiper-button-prev',
            hideOnClick: play
          }
          });
          swiperNotice.allowTouchMove= play;
          if (play) {
            $('.noticeBtn_show').show();
          } else {
              $('.notice_date').removeClass('notice_width');
              swiperNotice.autoplay.stop();
          }
      } else if ($('.swiperNotice').children('div').length == 0 && alias == 'index'){
      //用戶環境alias為index
          $('.detail_banner').empty();
          $('#swiperNotice').empty();
          $('#swiperBanner').show();
          var swiperBanner = new Swiper('#swiperBanner', {
              autoplay: {
                  disableOnInteraction: false,
                  delay: 5000,
              },
              loop: true
          }); 
      } else {
            $('#swiperNotice').empty();
            $('#swiperBanner').empty();
            $('.detail_banner').show();
      }
  });
});

function num(s) {
	return s < 10 ? '0' + s: s;
}
function FormatDate (strTime) {
  //strTime = strTime.substring(0, 25).replace(',', '');
  var pubDate = new Date(strTime);
  if(strTime.indexOf("CST")) {
  pubDate.setHours(pubDate.getHours()-14);
  }
  return pubDate;
}

function displayNotice(callback) {
	$.ajax({
    url: "/rss/tc/notice.rss",
		type: 'GET',
		dataType: 'xml',
		timeout: 20000,
    async: false,
		cache: false,
    global: false,
		success: function(res) {
      var data = $(res).find("channel");
      callback(data);
		},
		error: function(err) {
      // callback(null);
		}
	})
}


function bulidHTML(data) {
      var html = "";
      if (!data) return
      $(data).find("item").each(function() {
        var show = $(this).find("show").text();
        var repalceBody = "";
				if (window.navigator && window.navigator.msSaveOrOpenBlob) {
					replaceBody = $(this).context.lastChild.textContent;
				} else {
					replaceBody = $(this).context.lastChild.innerHTML.replace("<![CDATA[", "").replace("]]>", "");
				}
        if (show === "true" && $(this).context.lastChild.textContent) {
          var time = $(this).find("pubDate").text();
          time = time.replace(/ GMT.+$/, '');
          time = FormatDate(time);
				  var date = new Date(time);
				  dateStr = num(date.getDate()) + '/' + num((date.getMonth() + 1)) + '/' + num(date.getFullYear()) + ' ' + num(date.getHours())+ ':' + num(date.getMinutes());
          html += "<div class='swiper-slide'>";
          html += "<div class='swiper-slideDiv'>";
          html += "<div class='notice_content'>";
          html += "<div>" + replaceBody + "</div><br />";
          html += "<div class='notice_date'><span>發佈日期：</span><span>" + dateStr + "</span></div>";
          html += "</div></div></div>";
        }
      })
      $(".swiperNotice").append(html);
}


