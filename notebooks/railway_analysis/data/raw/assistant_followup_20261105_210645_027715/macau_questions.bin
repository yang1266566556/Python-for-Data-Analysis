//刷新變大字體
function changeFontAgain(el) {
	if (sessionStorage.temp_size == 2) {
		temp_size = 2;
		changeFont(el, 2);

	} else if (sessionStorage.temp_size == 4) {
		temp_size = 4;
		changeFont(el, 4);

	}
}



