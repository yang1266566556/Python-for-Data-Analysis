			$(this).parent().parent().find(".qabox_content").slideDown();
		};
	});
});</script>
<div class="qabox"  cms-search="true" >
    <div class="text_Title">輕軌系統小知識</div>
    <div style=" padding-top: 5px;">
           <img src="/images/title-icon.png" alt=""></div>
	<ul style="margin-top:20px;">
		   <li>
			<a class="qabox_title" href="javascript:void(0)"><span>輕軌的橡膠車輪在設計上有什麼安全考慮呢？</span><img class="imgBtn" src="/images/arrow.png" alt=""></a>
                        
			<div class="qabox_content">
				<div class="content_text"><span>澳門輕軌為膠輪系統，列車選用的橡膠輪胎較一般重軌鐵路系統使用的鋼輪能更有效減低聲音，而且膠輪內部還有一金屬輪，這樣的輪胎設計可確保列車即使發生輪胎漏氣或爆胎等情況，該金屬輪仍能協助列車運行，安全穩定地繼續行駛一定的路程至下一車站，確保乘客安全。</span></div>
			</div>
		  </li>
		   <li>
			<a class="qabox_title" href="javascript:void(0)"><span>輕軌行駛中途發生故障，有什麼緊急應變措施？</span><img class="imgBtn" src="/images/arrow.png" alt=""></a>
                        
			<div class="qabox_content">
				<div class="content_text"><span >如乘客遇有緊急情況需要協助，可透過列車上的對講機與運營控制中心的人員進行聯絡，列車也配有閉路電視可讓運營人員了解車廂內的情況。一般而言，列車還設有緊急把手，啟動後控制中心將收到警示信號，而列車則會於就近之車站停靠，並由站台工作人員協助乘客撤離。</span></div>
			</div>
		  </li>
		   <li>
			<a class="qabox_title" href="javascript:void(0)"><span>什麼是全自動列車控制系統？有什麼優點？</span><img class="imgBtn" src="/images/arrow.png" alt=""></a>
                        
			<div class="qabox_content">
				<div class="content_text"><span jhenghei="" microsoft="" style="color: rgb(0, 0, 0); font-family: 微軟正黑體, ">澳門輕軌採用全自動列車控制系統，主要是透過運營控制中心，利用先進的監察及通訊、信號系統，監控和調度整個輕軌系統的運作，毋須司機及車務人員進行操作，在世界各地包括鄰近地區如新加坡及台灣，已經累積了多年的成功運營經驗。</span><br jhenghei="" microsoft="" style="color: rgb(0, 0, 0); font-family: 微軟正黑體, " />
<span jhenghei="" microsoft="" style="color: rgb(0, 0, 0); font-family: 微軟正黑體, ">全自動列車控制系統透過先進的自動控制技術，靈活地調整列車的運行班次，確保列車準時、準點，提供更有效率的服務；此外，系統能有效地保持列車間固定之安全運行距離，可避免因人為操作失當而發生事故的情況，大大提高了系統的安全性，為乘客提供安全和高度可靠的軌道交通服務。</span></div>
			</div>
		  </li>
		   <li>
			<a class="qabox_title" href="javascript:void(0)"><span>澳門輕軌在能源利用方面作出了什麼考慮？</span><img class="imgBtn" src="/images/arrow.png" alt=""></a>
                        
			<div class="qabox_content">
				<div class="content_text"><span jhenghei="" microsoft="" style="color: rgb(0, 0, 0); font-family: 微軟正黑體, ">地球的天然資源日漸缺乏，因此澳門輕軌在能源利用方面作出了具體的措施，推動輕軌項目的可持續發展。</span><br jhenghei="" microsoft="" style="color: rgb(0, 0, 0); font-family: 微軟正黑體, " />
<span jhenghei="" microsoft="" style="color: rgb(0, 0, 0); font-family: 微軟正黑體, ">其中，澳門輕軌的制動系統（又即剎車系統）使用了再生制動技術，當輕軌列車減速或剎車時，列車上的馬達轉變為制動發電機，將列車的動能轉化為電能。再生制動系統不僅能達至制動的效果，亦可產生再生能源。這些再生電能可被附近的列車吸收，亦可利用蓄電池把再生電能貯存起來備用。這是一種非常有效的能源循環再用技術，體現了輕軌系統注重環保的設計理念。</span><br jhenghei="" microsoft="" style="color: rgb(0, 0, 0); font-family: 微軟正黑體, " />
<span jhenghei="" microsoft="" style="color: rgb(0, 0, 0); font-family: 微軟正黑體, ">此外，輕軌車廂在設計上落實環保節能的理念，採用LED照明系統。有別於傳統的光管（螢光燈）照明系統，使用LED燈不但能源消耗少，而且擁有穩定可靠、發光效率高和使用壽命長的特點。與光管相比，LED燈不含汞（水銀），不會對環境造成汞污染，比較環保。此外LED燈具有即開即亮、常開常關無損壽命及較難打破的優點，均比光管優勝。</span>

<div style="text-align: center;"><span jhenghei="" microsoft="" style="color: rgb(0, 0, 0); font-family: 微軟正黑體, "><img alt="" src="/images/questions/question_img1.jpg" style="width: 70%;" /></span></div></div>
			</div>
		  </li>
		   <li>
			<a class="qabox_title" href="javascript:void(0)"><span>澳門的輕軌有什麼特點？</span><img class="imgBtn" src="/images/arrow.png" alt=""></a>
                        
			<div class="qabox_content">
				<div class="content_text"><span>澳門輕軌的三個主要特點：便捷、環保、無障礙，其中：</span><br />
<span><u>便捷</u></span><br />
<span>汽車是十分佔用公共道路資源的交通工具，而輕軌系統具有專屬路權，避開了擁擠的地面道路，保證輕軌列車在行駛期間絕對不受路面交通情況的影響。同時，使用全自動列車控制系統可確保列車服務準時準點，並可按實際需要增加服務班次，便利居民出行。</span><br />
<span>輕軌的引入，可望減少市民駕駛汽車或電單車出行的數量，透過輕軌為主、巴士/的士為輔的公共出行整合模式，有助增加居民使用公共交通出行的意慾，長遠可緩解道路交通擠塞的壓力。</span><br />
<br />
<span><u>環保</u></span><br />
<span>車輛排放的污染物和廢氣是本澳主要的空氣污染源之一。而廢氣更是導致區域及全球暖化的主要源頭之一。以電力推動的輕軌系統除了是零排放外，也能藉着減少交通堵塞而改善空氣質素，是一種綠色交通工具。此外，透過適當的設計考慮，車站及列車可採用更節能的方式運行，能夠有效節約能源。</span><br />
<br />
<span><u>無障礙</u></span><br />
<span>在設計輕軌系統的各種設施時，已引入方便傷健人士和長者使用的無障礙理念。例如設置合適高度比例的扶手梯、設語音廣播系統的升降機、導盲地磚、盲文、方便輪椅上落的斜坡及特殊的資訊系統等，方便有需要人士更便利地使用。在月台方面，除發聲報站系統外，設計上亦盡量減少月台與車廂之間的間隙，便於輪椅使用者進出車廂。在靠近車廂出入口的座位可摺疊收起成為輪椅空間，座位下方設有定點以固定輪椅位置，照顧不同乘客需要，並確保輪椅使用者的乘車安全。</span></div>
			</div>
		  </li>
		   <li>
			<a class="qabox_title" href="javascript:void(0)"><span>為什麼澳門要選用輕軌?</span><img class="imgBtn" src="/images/arrow.png" alt=""></a>
                        
			<div class="qabox_content">
				<div class="content_text"><span>澳門輕軌是全自動列車控制的中運量集體運輸系統，以兩節車廂為一編組，以一組或兩組的方式行駛。由於採用了全自動列車控制系統，列車運作全由運營控制中心負責監察和控制，所以車廂內毋須設置司機席，可以騰出更多內部空間載運乘客。此外省卻人手調配的問題，也令列車班次調動有更大的彈性。故輕軌列車每節車廂大小雖如一般的大巴士，但卻可載運更多的乘客。</span><br jhenghei="" microsoft="" style="color: rgb(0, 0, 0); font-family: 微軟正黑體, " />
<br />
<span>澳門選用輕軌的主要原因包括：</span>

<ol>
	<li>輕軌的行走路線可容許較小的轉彎半徑及較陡的坡度，較適合澳門這類人口稠密及客觀環境限制較多的城巿；</li>
	<li>由於採用橡膠輪胎及行走於平滑混凝土路面，運作時的聲音較低，對周邊環境造成的影響較小，適合於密集的市區環境內運行；</li>
	<li>載客量雖較一般重軌系統低，但所需要的建造時間較少，而建造和營運成本也相對較低。</li>
</ol></div>
			</div>
		  </li>
		   <li>
			<a class="qabox_title" href="javascript:void(0)"><span>澳門輕軌各線路長度？行車時間如何？</span><img class="imgBtn" src="/images/arrow.png" alt=""></a>
                        
			<div class="qabox_content">
				<div class="content_text">澳門輕軌現行線路設有氹仔線、石排灣線及橫琴線，各線路的行車時間如下：<br />
 
<table border="1" cellpadding="0" cellspacing="0">
	<tbody>
		<tr>
			<td style="width:200px;height:5px; padding: 10px;">線路</td>
			<td style="width: 200px; padding: 10px; height: 5px; text-align: center;">長度（公里）</td>
			<td style="width: 200px; padding: 10px; height: 5px; text-align: center;">車站（個）</td>
			<td style="width: 200px; height: 5px; text-align: center;">行車時間（分鐘）</td>
		</tr>
		<tr>
			<td style="width:200px; padding: 10px;">氹仔線</td>
			<td style="width: 200px; padding: 10px; text-align: center;">12.5</td>
			<td style="width: 200px; padding: 10px; text-align: center;">12</td>
			<td style="width: 200px; padding: 10px; text-align: center;">28</td>
		</tr>
		<tr>
			<td style="width:200px; padding: 10px;">石排灣線</td>
			<td style="width: 200px; padding: 10px; text-align: center;">1.6</td>
			<td style="width: 200px; padding: 10px; text-align: center;">2</td>
			<td style="width: 200px; padding: 10px; text-align: center;">2</td>
		</tr>
		<tr>
			<td style="width:200px; padding: 10px;">橫琴線</td>
			<td style="width: 200px; padding: 10px; text-align: center;">2.2</td>
			<td style="width: 200px; padding: 10px; text-align: center;">2</td>
			<td style="width: 200px; padding: 10px; text-align: center;">2</td>
		</tr>
	</tbody>
</table></div>
			</div>
		  </li>
		   <li>
			<a class="qabox_title" href="javascript:void(0)"><span>澳門輕軌列車服務幾多分鐘一班？</span><img class="imgBtn" src="/images/arrow.png" alt=""></a>
                        
			<div class="qabox_content">
				<div class="content_text">輕軌氹仔線每班次約5至10.5分鐘；石排灣線每班次約6分鐘；橫琴線每班次約6分鐘；服務可因應實際需要加密和調整班次以疏導人流。</div>
			</div>
		  </li>
		   <li>
			<a class="qabox_title" href="javascript:void(0)"><span>澳門輕軌的運營時間如何？</span><img class="imgBtn" src="/images/arrow.png" alt=""></a>
                        
			<div class="qabox_content">
				<div class="content_text">澳門輕軌運營時間為週一至週四早上6時30分至23時15分，而週五至週日及公眾假期為早上6時30分至23時59分，每晚完成運營工作後會進行系統的保養和維護工作。</div>
			</div>
		  </li>
		   <li>
			<a class="qabox_title" href="javascript:void(0)"><span>澳門輕軌車速是多少？</span><img class="imgBtn" src="/images/arrow.png" alt=""></a>
                        
			<div class="qabox_content">
				<div class="content_text"><span>將停站時間計算在內，輕軌平均速度約每小時25公里。事實上，列車設計的最高運行時速可達80公里。而由於澳門各個輕軌站之間的距離較短，而且彎位較多，為確保乘客的乘車舒適度，一般會以較平穩的速度行駛。</span></div>
			</div>
		  </li>
	</ul>
</div></div></div></div></div></div></div></div><div class="cms-layout-row" style=""><div key="r2c0" class="cms-layout-column" style=""><div section-id="2363" class="cms-section" style="padding: 0px; "><div style="margin: 0 auto; padding: 0;"><div class="ad_swiper" >

<div class="swiperPicture swiper-no-swiping" cms-search="true">
<div class="swiper-button-prev swiperBtn_show"><img style="  width: 30px;
    height: 30px;" src="/images/left.png"></div>
  <div class="swiper-container" id="swiper2">
<div class="swiper-wrapper">
    </div>
  </div>
<div class="swiper-button-next swiperBtn_show"><img style="  width: 30px;
    height: 30px;" src="/images/right.png"></div></div>
</div>
</div>
<script>
if ($('.swiper-wrapper #swiper_num').length > 0) {
var canMove = false;
var swiping = true;
var autoplay = false;
var showNum = $('.swiper-wrapper #swiper_num').length > 4 ? 4 : $('.swiper-wrapper #swiper_num').length;
var hideBtn = true;
var pc = sessionStorage.getItem("pc");
if ($('.menu_div').width() > 500 && $('.swiper-wrapper #swiper_num').length < 5) {
    showNum = $('.swiper-wrapper #swiper_num').length;
     autoplay = false;
     hideBtn = true;
} else if ($('.menu_div').width() > 500 && $('.swiper-wrapper #swiper_num').length > 4){
    showNum = 4;
    autoplay = true;
    hideBtn = false;
    $('.swiperBtn_show').show();
} else if ($('.menu_div').width() < 500 && pc !== "true") {
    showNum = 1
    autoplay = true;
    hideBtn = false;
    canMove = true;
   swiping = false;
    $('.swiperBtn_show').show();
} 
}
$(function(){
if ($('.swiper-wrapper #swiper_num').length > 0) {
  $('.ad_swiper').show();
}
var swiper2 = new Swiper('#swiper2', {
       paginationClickable :true,
       noSwiping : swiping,
       autoplay: autoplay,
      slidesPerView: showNum,
      loop : true,
      spaceBetween: 10,
      navigation: {
      nextEl: '.swiper-button-next',
      prevEl: '.swiper-button-prev',
      hideOnClick: hideBtn
    },
     breakpoints: {
        500: {  //当屏幕宽度小于等于500
          slidesPerView: 1,
          spaceBetween: 20
        }
     }
    });
  swiper2.allowTouchMove= canMove;
})
