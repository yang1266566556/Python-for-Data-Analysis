}
.change_app,.change_view {
	color: #333333;
	border-right: 1px solid #D8D8D8;
	line-height: 16px;
}
.changeSize {
	display: flex;
	align-items: center;
}
.logo {
	float: left;
	padding: 5px 0px;
	position: absolute;
	z-index: 99;
}
.header_setting {
	padding: 5px 0px;
	align-items: center;
	line-height: 12px;
