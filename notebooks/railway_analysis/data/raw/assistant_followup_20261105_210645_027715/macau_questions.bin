#marqueeBox {
	display: flex;
	align-items: center;
	height: 55px;
}
.blackBox {
	width: 100%;
	height: 100%;
	display: none;
	z-index: 999;
	position: fixed;
	background-color: rgba(0,0,0,0.5);
}
.alert_box>div {
	display: flex;
	align-items: flex-start;
	font-size: 20px;
	padding: 10px 0px;
	color: #FFFFFF;
}
.alert_box a {
