padding-bottom:50px;"><div key="r0c0" class="cms-layout-column appContainer" style=""><div section-id="2366" class="cms-section" style="padding: 0px; "><div style="margin: 0 auto; padding: 0;"><script type="text/javascript">$(function() {
	$(".qabox_title").on('click',
	function() {
		if ($(this).parent().hasClass("select")) {
			$(this).parent().removeClass("select");
			$(this).parent().find(".qabox_content").slideUp();
		} else {
			$(this).parent().addClass("select");
			$(this).parent().find(".qabox_content").slideDown();
			$(this).parent().siblings().removeClass('select').find('.qabox_content').slideUp();
		};
		//$(this).parent().siblings().removeClass('select').find('.qabox_content').slideUp();
	});
	$(".imgBtn").click(function(event) {
		event.stopPropagation();
		if ($(this).parent().parent().hasClass("select")) {
