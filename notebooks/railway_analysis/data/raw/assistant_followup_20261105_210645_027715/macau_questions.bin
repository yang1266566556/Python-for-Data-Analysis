body {
font-family: "微軟正黑體", "Microsoft JhengHei", "新細明體", "PMingLiU", AppleGothic, Dotum, Lucida Grande, Verdana Sans-serif;
}

.imgBtn {
	padding: 10px 5px;
	display: block;
	border-radius: 50%;
	background-color: #fff;
	transform: rotate(0deg);
	transition: .2s all ease;
	width: 20px;
	height: 10px;
}
.text_Title {
	color: #039BDA;
	font-size: 28px;
	font-weight: bold;
}
.qabox {
	font-size: 20px;
}
.qabox ul {
	list-style: none;
	margin: 0;
	padding: 0;
}
.qabox>ul>li {
	margin: 15px 0;
}
.qabox_title {
	overflow: hidden;
	display: flex;
	align-items: center;
	background: linear-gradient(180deg,rgba(25,177,241,1) 0%,rgba(13,169,234,1) 100%);
	color: #fff;
	padding: 1.5% 2%;
}
.qabox_title::before,.qabox_content::before {
	content: "";
	width: 1.5em;
	height: 1.5em;
	margin-right: 10px;
	display: block;
	background: url(/images/Q.png);
	background-size: 100%;
	background-repeat: no-repeat;
	float: left;
}
.qabox_title1::after {
	content: "";
	width: 1.5em;
	height: 1.5em;
	float: left;
	display: block;
	border-radius: 50%;
	background-color: #fff;
	background-image: url(/images/arrow.png);
	background-position: center;
	background-repeat: no-repeat;
	background-size: 50%;
	transform: rotate(0deg);
	transition: .2s all ease;
}
.select1 a::after,.select .imgBtn {
	transform: rotate(180deg);
}
.qabox_title span {
	float: left;
	display: inline-block;
	width: calc(100% - 3em - 20px);
	margin-right: 10px;
	text-align: justify;
}
.qabox_content {
	display: none;
	overflow: hidden;
	background: #EFFAFF;
	padding: 2%;
}
.qabox_content .content_text {
	float: left;
	display: inline-block;
	width: calc(100% - 1.5em - 10px);
	color: #333;
	line-height: 1.5em;
	text-align: justify;
}
body .qabox_content::before {
	background-image: url(/images/A.png);
}

</style>
