	margin: 0px 30px;
}
.warning_div ul {
	list-style: none;
	padding: 0;
	height: 100%;
	margin: 0px;
	text-align: center;
	display: flex;
}
.warning_div {
	background-color: #C7182E;
	overflow: hidden;
	display: none;
	z-index: 100;
	position: fixed;
	width: 100%;
}
.warning_text img {
	padding-right: 10px;
	max-width: 30px !important;
	vertical-align: text-top;
}
.warning_text {
	color: #ffffff;
	font-size: 26px;
	text-decoration: none;
}
.warning_text a {
