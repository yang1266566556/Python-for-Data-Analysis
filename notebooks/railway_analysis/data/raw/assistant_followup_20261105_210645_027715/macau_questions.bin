	color: #A7E6FF;
}
.alert_box {
	padding: 30px;
}
.alert_box img {
	width: 30px;
	padding-right: 5px;
}
.alert_windows {
	position: fixed;
	display: none;
	z-index: 1000;
	max-width: 320px;
	width: 100%;
	background-color: #C7182E;
	max-height: 400px;
	overflow: scroll;
}
.close_span {
	float: right;
	cursor: pointer;
